<config xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
        xmlns="http://www.ehcache.org/v3"
        xsi:schemaLocation="http://www.ehcache.org/v3 http://www.ehcache.org/schema/ehcache-core-3.0.xsd">

    <!-- Cache par défaut pour Hibernate L2 Cache -->
    <cache-template name="default-template">
        <expiry>
            <ttl unit="minutes">60</ttl>
        </expiry>
        <resources>
            <heap unit="entries">2000</heap>
        </resources>
    </cache-template>

    <!-- Cache pour les entités Utilisateur -->
    <cache alias="com.example.model.Utilisateur" uses-template="default-template"/>

    <!-- Cache pour les entités Salle -->
    <cache alias="com.example.model.Salle" uses-template="default-template"/>

    <!-- Cache pour les requêtes Hibernate (Query Cache) -->
    <cache alias="default-query-results-region" uses-template="default-template"/>
    <cache alias="default-update-timestamps-region">
        <expiry>
            <none/>
        </expiry>
        <resources>
            <heap unit="entries">10000</heap>
        </resources>
    </cache>
</config>
